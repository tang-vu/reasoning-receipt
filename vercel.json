{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "{agent,protocol,server,storage,wallets}/**"
    },
    "api/irys-upload.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/irys-upload).*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/cron/agent-batch",
      "schedule": "0 2 * * *"
    }
  ]
}
